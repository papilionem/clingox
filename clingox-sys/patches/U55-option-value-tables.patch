Fix for clingox UPSTREAM-ISSUES U55: registering clingo's options appends to
process-wide value tables without a lock, so clingo_main and
clingo_control_new on two threads corrupt the heap.

The values of --output, --output-debug and --mode are parsed through
Potassco::ProgramOptions::values<T>(), a function-local static vector per
enumeration. registerOptions and ClingoApp::initOptions appended the names to
it on every call, so the vectors also grew by four entries per control.
clingo_control_new holds a mutex while it registers, clingo_main does not, so
an application starting on one thread while a control is created on another
reallocated the same vector twice: double free, heap corruption, or a crash.
Each table is now filled once by the initializer of a function-local static
reference, which C++11 runs exactly once and thread-safely; later calls only
read it. Against clingo v5.8.2; suitable for upstream.

diff --git a/libclingo/src/clingo_app.cc b/libclingo/src/clingo_app.cc
--- a/libclingo/src/clingo_app.cc
+++ b/libclingo/src/clingo_app.cc
@@ -43,9 +43,12 @@
     registerOptions(gringo, grOpts_, GringoOptions::AppType::Clingo);
     root.add(gringo);
     OptionGroup basic("Basic Options");
+    // The value table is process-wide: fill it once, thread-safely, instead of
+    // appending to it on every call.
+    static auto &modes = values<Mode>()("clingo", mode_clingo)("clasp", mode_clasp)("gringo", mode_gringo);
     basic.addOptions()(
         "mode",
-        storeTo(mode_ = mode_clingo, values<Mode>()("clingo", mode_clingo)("clasp", mode_clasp)("gringo", mode_gringo)),
+        storeTo(mode_ = mode_clingo, modes),
         "Run in {clingo|clasp|gringo} mode");
     root.add(basic);
     app_->register_options(*this);
