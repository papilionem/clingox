@@ -38,7 +45,21 @@ namespace Clasp {
 // StatisticObject
 /////////////////////////////////////////////////////////////////////////////////////////
 StatisticObject::I      StatisticObject::empty_s(Potassco::Statistics_t::Empty);
-StatisticObject::RegVec StatisticObject::types_s(1, &StatisticObject::empty_s);
+const StatisticObject::I* StatisticObject::types_s[StatisticObject::max_types] = {&StatisticObject::empty_s};
+// Types register lazily from function-local statics, so two threads may
+// register different types at once. tid() reads without a lock: it only sees
+// ids returned after their slot was written, and the thread-safe init of
+// those statics orders that write before any use of the id.
+uint32 StatisticObject::registerType(const I* vtab) {
+#if CLASP_HAS_THREADS
+	static mt::mutex lock;
+	mt::lock_guard<mt::mutex> guard(lock);
+#endif
+	static uint32 size = 1;
+	if (size == max_types) { std::fputs("clasp: too many statistic types\n", stderr); std::abort(); }
+	types_s[size] = vtab;
+	return size++;
+}

