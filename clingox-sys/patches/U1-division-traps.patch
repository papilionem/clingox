+// Division and modulo by zero are undefined, and so are INT_MIN / -1 and
+// INT_MIN % -1, which overflow and trap on x86.
+bool isUndefined(BinOp op, int x, int y) {
+    return (op == BinOp::DIV || op == BinOp::MOD) && (y == 0 || (y == -1 && x == std::numeric_limits<int>::min()));
+}
