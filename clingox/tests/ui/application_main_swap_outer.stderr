   |
12 |     let mut outer: Control = Control::new().unwrap();
   |         --------- `outer` declared here, outside of the closure body
13 |     Application::new()
14 |         .main(|ctl, _files| {
   |                --- `ctl` is a reference that is only valid in the closure body
